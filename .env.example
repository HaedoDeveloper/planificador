NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# Leave blank until the development application is registered in Entra.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Generate locally; never commit the actual value.
SESSION_SECRET=
# Local development defaults to SQLite in .data/. Production requires PostgreSQL.
DATABASE_URL=
SQLITE_PATH=.data/planificador.sqlite
# Enable only behind the loopback Nginx reverse proxy.
TRUST_PROXY=false
# Temporary local preview only; ignored in production and once Entra is configured.
DEV_LOGIN_ENABLED=false
# One central check against the official website every six hours.
SCHEDULE_REFRESH_MINUTES=360
