{
  "name": "planificador-frh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/main.js",
    "dev": "node --env-file-if-exists=.env --watch server/main.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "admin": "node --env-file-if-exists=.env server/admin.js"
  },
  "dependencies": {
    "@azure/msal-node": "7.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "parse5-sax-parser": "8.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.0"
  }
}
